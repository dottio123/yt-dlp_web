@page "/history"
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>yt-dlp_web | History</PageTitle>

<h1>Download History</h1>

<button class="btn btn-sm btn-secondary mb-3" @onclick="RefreshList">Refresh</button>

@if (isLoading)
{
    <p>Loading downloads...</p>
}
else if (downloads.Count == 0)
{
    <p class="text-muted">No downloads yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Size</th>
                    <th>Modified</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var file in downloads)
                {
                    <tr>
                        <td>@file.Name</td>
                        <td>@FormatFileSize(file.Size)</td>
                        <td>@file.Modified.ToString("g")</td>
                        <td>
                            <a href="@file.DownloadUrl" class="btn btn-sm btn-primary" download>Download</a>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteFile(file.Name)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<DownloadFile> downloads = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await RefreshList();
    }

    private async Task RefreshList()
    {
        isLoading = true;
        try
        {
            var resp = await Http.GetAsync("api/downloads");
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<List<DownloadFile>>();
                downloads = result ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading downloads: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteFile(string fileName)
    {
        if (!await ConfirmDelete(fileName))
            return;

        try
        {
            var resp = await Http.DeleteAsync($"api/downloads/{Uri.EscapeDataString(fileName)}");
            if (resp.IsSuccessStatusCode)
            {
                await RefreshList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting file: {ex.Message}");
        }
    }

    private async Task<bool> ConfirmDelete(string fileName)
    {
        return await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete {fileName}?");
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    @inject IJSRuntime JSRuntime

    private class DownloadFile
    {
        public string Name { get; set; } = string.Empty;
        public long Size { get; set; }
        public DateTime Modified { get; set; }
        public string DownloadUrl { get; set; } = string.Empty;
    }
}
