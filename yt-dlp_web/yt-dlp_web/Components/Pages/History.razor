@page "/history"
@rendermode InteractiveServer
@using yt_dlp_web.Services
@inject IDownloadStore Store
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<PageTitle>YT-DLP Web | History</PageTitle>

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1 fw-bold">Download History</h1>
        <p class="text-secondary mb-0">Browse, play, and manage previously downloaded media files.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-secondary btn-sm" @onclick="RefreshList" disabled="@isLoading">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="@(isLoading ? "spinner-border spinner-border-sm" : "")">
                <polyline points="23 4 23 10 17 10"></polyline>
                <polyline points="1 20 1 14 7 14"></polyline>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
            </svg>
            <span>Refresh</span>
        </button>

        <button class="btn btn-sm btn-ghost text-danger" @onclick="DeleteAll" disabled="@(downloads.Count == 0 || isLoading)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
            <span>Delete All</span>
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(actionError))
{
    <div class="modern-card p-3 mb-4 d-flex align-items-center justify-content-between gap-3" style="background-color: var(--accent-red-light); border: 1px solid rgba(255, 0, 51, 0.2);">
        <div class="d-flex align-items-center gap-2" style="color: var(--accent-red);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span class="small fw-semibold">@actionError</span>
        </div>
        <button class="btn btn-ghost btn-sm p-1" @onclick="() => actionError = null" title="Dismiss">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>
}

@if (isLoading)
{
    <div class="modern-card p-5 text-center">
        <div class="spinner-border text-danger mb-3" role="status"></div>
        <p class="text-secondary mb-0">Loading downloaded files...</p>
    </div>
}
else if (downloads.Count == 0)
{
    <div class="modern-card p-5 text-center">
        <div style="width: 64px; height: 64px; background: var(--bg-card-secondary); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; color: var(--text-muted);">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
        </div>
        <h5 class="fw-bold mb-1">No Downloads Yet</h5>
        <p class="text-secondary mb-3">Videos you download will be archived here for easy preview and downloading.</p>
        <a href="" class="btn btn-youtube">
            <span>Download a Video</span>
        </a>
    </div>
}
else
{
    <div class="modern-card overflow-hidden">
        <div class="table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>File</th>
                        <th>Size</th>
                        <th>Date Modified</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var file in downloads)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (MediaFileTypes.IsAudio(file.Name))
                                    {
                                        <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(168, 85, 247, 0.15); color: #a855f7; display: flex; align-items: center; justify-content: center; flex-shrink: 0;" title="Audio File">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M9 18V5l12-2v13"></path>
                                                <circle cx="6" cy="18" r="3"></circle>
                                                <circle cx="18" cy="16" r="3"></circle>
                                            </svg>
                                        </div>
                                    }
                                    else if (MediaFileTypes.IsImage(file.Name))
                                    {
                                        <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(16, 185, 129, 0.15); color: #10b981; display: flex; align-items: center; justify-content: center; flex-shrink: 0;" title="Thumbnail Image">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                                <polyline points="21 15 16 10 5 21"></polyline>
                                            </svg>
                                        </div>
                                    }
                                    else if (MediaFileTypes.IsSubtitle(file.Name))
                                    {
                                        <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(234, 179, 8, 0.15); color: #eab308; display: flex; align-items: center; justify-content: center; flex-shrink: 0;" title="Subtitles">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="2" y="4" width="20" height="16" rx="3"></rect>
                                                <path d="M7 15h3"></path>
                                                <path d="M14 15h3"></path>
                                                <path d="M7 11h10"></path>
                                            </svg>
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--accent-red-light); color: var(--accent-red); display: flex; align-items: center; justify-content: center; flex-shrink: 0;" title="Video File">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                                <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                            </svg>
                                        </div>
                                    }
                                    <div class="overflow-hidden">
                                        <div class="fw-semibold text-truncate" style="max-width: 420px;" title="@file.Name">@file.Name</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge rounded-pill" style="background-color: var(--bg-card-secondary); color: var(--text-main); border: 1px solid var(--border-color); font-family: ui-monospace, monospace;">
                                    @FormatFileSize(file.Size)
                                </span>
                            </td>
                            <td class="text-secondary small">
                                @file.Modified.ToString("MMM d, yyyy h:mm tt")
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex align-items-center gap-1">
                                    @if (MediaFileTypes.IsPlayable(file.Name))
                                    {
                                        <button class="btn btn-sm btn-secondary" @onclick="() => PlayMedia(file)" title="Preview Media">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                                <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                            </svg>
                                            <span>Play</span>
                                        </button>
                                    }

                                    <a href="@file.DownloadUrl" class="btn btn-sm btn-ghost" title="Save File" download>
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                            <polyline points="7 10 12 15 17 10"></polyline>
                                            <line x1="12" y1="15" x2="12" y2="3"></line>
                                        </svg>
                                    </a>

                                    <button class="btn btn-sm btn-ghost text-danger" @onclick="() => DeleteFile(file.Name)" title="Delete File">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Media Player Modal -->
<MediaPlayerModal IsOpen="isPlayerOpen"
                  Title="@activeFile?.Name"
                  MediaUrl="@activeMediaUrl"
                  DownloadUrl="@activeDownloadUrl"
                  SubtitleUrls="@activeSubtitleUrls"
                  OnClose="ClosePlayer" />

@code {
    private List<DownloadFileInfo> downloads = new();
    private bool isLoading = true;
    private string? actionError;

    // Player state
    private bool isPlayerOpen;
    private DownloadFileInfo? activeFile;
    private string? activeMediaUrl;
    private string? activeDownloadUrl;
    private IReadOnlyList<string>? activeSubtitleUrls;

    protected override void OnInitialized()
    {
        RefreshList();
    }

    private void PlayMedia(DownloadFileInfo file)
    {
        activeFile = file;
        activeMediaUrl = $"downloads/{Uri.EscapeDataString(file.Name)}";
        activeDownloadUrl = file.DownloadUrl;
        activeSubtitleUrls = MediaFileTypes.PlayableSubtitlesFor(file.Name, downloads.Select(d => d.Name))
            .Select(name => $"downloads/{Uri.EscapeDataString(name)}")
            .ToList();
        isPlayerOpen = true;
    }

    private void ClosePlayer()
    {
        isPlayerOpen = false;
        activeFile = null;
        activeMediaUrl = null;
        activeDownloadUrl = null;
        activeSubtitleUrls = null;
    }

    private void RefreshList()
    {
        isLoading = true;
        try
        {
            downloads = Store.List().ToList();
        }
        catch (Exception ex)
        {
            actionError = $"Error loading downloads: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteFile(string fileName)
    {
        if (!await ConfirmDelete(fileName))
            return;

        actionError = null;
        try
        {
            var deleted = Store.Delete(fileName);
            if (!deleted)
            {
                actionError = $"Could not delete {fileName}.";
            }
            RefreshList();
        }
        catch (Exception ex)
        {
            actionError = $"Error deleting file: {ex.Message}";
        }
    }

    private async Task DeleteAll()
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete all downloaded files?"))
            return;

        actionError = null;
        try
        {
            Store.DeleteAll();
            RefreshList();
        }
        catch (Exception ex)
        {
            actionError = $"Error deleting all files: {ex.Message}";
        }
    }

    private async Task<bool> ConfirmDelete(string fileName)
    {
        return await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete {fileName}?");
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
