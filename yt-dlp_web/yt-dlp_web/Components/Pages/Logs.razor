@page "/logs"
@rendermode InteractiveServer
@inject ILoggingService Logger

<PageTitle>YT-DLP Web | Logs</PageTitle>

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1 fw-bold">System Logs</h1>
        <p class="text-secondary mb-0">Diagnostic audit trail of downloads, background updates, and engine errors.</p>
    </div>
    <button class="btn btn-secondary btn-sm" @onclick="RefreshLogs">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="23 4 23 10 17 10"></polyline>
            <polyline points="1 20 1 14 7 14"></polyline>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
        </svg>
        <span>Refresh</span>
    </button>
</div>

<!-- Filter Tabs -->
<div class="d-flex align-items-center gap-2 mb-3 overflow-x-auto pb-1">
    <button class="btn btn-sm @(currentFilter == "all" ? "btn-youtube" : "btn-secondary")" @onclick="@(() => FilterLogsBy("all"))">
        All Logs (@allLogs.Count)
    </button>
    <button class="btn btn-sm @(currentFilter == "download" ? "btn-youtube" : "btn-secondary")" @onclick="@(() => FilterLogsBy("download"))">
        Downloads
    </button>
    <button class="btn btn-sm @(currentFilter == "update" ? "btn-youtube" : "btn-secondary")" @onclick="@(() => FilterLogsBy("update"))">
        Updates
    </button>
    <button class="btn btn-sm @(currentFilter == "error" ? "btn-youtube" : "btn-secondary")" @onclick="@(() => FilterLogsBy("error"))">
        Errors
    </button>
</div>

@if (filteredLogs.Count == 0)
{
    <div class="modern-card p-5 text-center">
        <div style="width: 56px; height: 56px; background: var(--bg-card-secondary); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; color: var(--text-muted);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="4 17 10 11 4 5"></polyline>
                <line x1="12" y1="19" x2="20" y2="19"></line>
            </svg>
        </div>
        <h5 class="fw-bold mb-1">No Logs Found</h5>
        <p class="text-secondary mb-0">No log entries matching the selected filter.</p>
    </div>
}
else
{
    <div class="modern-card overflow-hidden">
        <div class="table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th style="width: 170px;">Timestamp</th>
                        <th style="width: 130px;">Event</th>
                        <th>Details</th>
                        <th style="width: 140px;">Client IP</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in filteredLogs)
                    {
                        var isError = log.Type == "Error";
                        var isDownload = log.Type == "Download";
                        var isUpdate = log.Type == "Update";

                        var badgeStyle = isError
                            ? "background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.25);"
                            : isUpdate
                                ? "background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.25);"
                                : isDownload
                                    ? "background: rgba(59, 130, 246, 0.15); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.25);"
                                    : "background: var(--bg-card-secondary); color: var(--text-secondary); border: 1px solid var(--border-color);";

                        var displayType = isError && !string.IsNullOrEmpty(log.RelatedType)
                            ? $"{log.RelatedType} Error"
                            : log.Type;

                        <tr>
                            <td class="text-secondary small" style="font-family: ui-monospace, monospace;">
                                @log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")
                            </td>
                            <td>
                                <span class="badge rounded-pill fw-semibold" style="@badgeStyle">
                                    @displayType
                                </span>
                            </td>
                            <td>
                                <div class="text-main" style="word-break: break-word;">@log.Message</div>
                                @if (!string.IsNullOrEmpty(log.FileName))
                                {
                                    <div class="small text-muted mt-1 font-monospace text-truncate" style="max-width: 500px;" title="@log.FileName">
                                        📁 @log.FileName
                                    </div>
                                }
                            </td>
                            <td class="text-secondary small font-monospace">
                                @(log.ClientIp ?? "–")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<LogEntry> allLogs = new();
    private List<LogEntry> filteredLogs = new();
    private string currentFilter = "all";

    protected override void OnInitialized()
    {
        RefreshLogs();
    }

    private void RefreshLogs()
    {
        allLogs = Logger.GetLogs(200);
        ApplyFilter();
    }

    private void FilterLogsBy(string filter)
    {
        currentFilter = filter;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var logs = currentFilter switch
        {
            "download" => Logger.GetDownloadLogs(100),
            "update" => Logger.GetUpdateLogs(100),
            "error" => allLogs.Where(l => l.Type == "Error").ToList(),
            _ => allLogs
        };
        filteredLogs = logs.OrderByDescending(l => l.Timestamp).ToList();
    }
}
